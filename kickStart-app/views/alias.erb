<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Alias - CVU - Tarjeta Virtual</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    
    body {
      background: #f4f4f4;
      color: #333;
      padding: 20px;
      line-height: 1.6;
    }
    
    .container {
      max-width: 600px;
      margin: 0 auto;
      background: white;
    }
    
    .header {
      text-align: center;
      padding: 20px 0;
      border-bottom: 1px solid #eee;
      margin-bottom: 20px;
    }
    
    .header h1 {
      font-size: 28px;
      margin-bottom: 5px;
      color: #2c3e50;
    }
    
    .user-name {
      font-size: 20px;
      font-weight: 500;
      color: #555;
    }
    
    .section {
      margin-bottom: 30px;
      padding: 20px;
      border-radius: 10px;
      background: #f9f9f9;
    }
    
    .section-title {
      font-size: 22px;
      color: #2c3e50;
      margin-bottom: 20px;
      padding-bottom: 10px;
      border-bottom: 1px solid #ddd;
    }
    
    .account-details {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
      margin-bottom: 20px;
    }
    
    .account-item {
      padding: 15px;
      background: white;
      border-radius: 8px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }
    
    .info-label {
      font-size: 14px;
      color: #777;
      margin-bottom: 5px;
    }
    
    .info-value {
      font-size: 18px;
      font-weight: 500;
      color: #2c3e50;
      word-break: break-all;
    }
    
    .btn-change {
      display: block;
      width: 100%;
      padding: 15px;
      background: #e74c3c;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 18px;
      cursor: pointer;
      text-decoration: none;
      text-align: center;
      font-weight: 600;
      margin-top: 10px;
      transition: background 0.3s;
    }
    
    .btn-change:hover {
      background: #c0392b;
    }
    
    .virtual-card {
      background: linear-gradient(135deg, #2c3e50, #4ca1af);
      color: white;
      border-radius: 12px;
      padding: 20px;
      margin-top: 20px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.15);
      position: relative;
      min-height: 280px;
      display: flex;
      flex-direction: column;
    }
    
    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }
    
    .card-id {
      font-size: 18px;
      font-weight: bold;
      background: rgba(255, 255, 255, 0.2);
      padding: 5px 10px;
      border-radius: 4px;
    }
    
    .card-logo {
      font-weight: bold;
      font-size: 20px;
    }
    
    .card-number {
      font-size: 25px;
      letter-spacing: 3px;
      text-align: center;
      margin: 10px 0;
      font-family: monospace;
      font-weight: 500;
      padding: 10px;
      background: rgba(0, 0, 0, 0.1);
      border-radius: 5px;
    }
    
    .card-details {
      display: flex;
      justify-content: space-between;
      margin-top: 25px;
    }
    
    .card-holder, .card-expiry {
      flex: 1;
    }
    
    .card-label {
      font-size: 14px;
      opacity: 0.8;
      margin-bottom: 5px;
    }
    
    .card-value {
      font-size: 18px;
      font-weight: 600;
    }
    
    
    .card-footer {
      display: flex;
      justify-content: flex-end;
      margin-top: auto;
      padding-top: 15px;
    }
    
    .card-cvv {
      font-size: 18px;
      font-weight: 500;
      background: rgba(0, 0, 0, 0.3);
      padding: 8px 15px;
      border-radius: 5px;
      color: white;
    }
    
    .no-card {
      text-align: center;
      padding: 30px;
      background: #f9f9f9;
      border-radius: 10px;
      border: 1px dashed #ddd;
      margin-top: 20px;
    }
    
    .no-card p {
      margin-bottom: 20px;
      color: #777;
      font-size: 18px;
    }
    
    .btn-generate {
      display: inline-block;
      padding: 12px 25px;
      background: #2ecc71;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 16px;
      cursor: pointer;
      text-decoration: none;
      font-weight: 600;
      transition: background 0.3s;
    }
    
    .btn-generate:hover {
      background: #27ae60;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Información de Cuenta</h1>
      <div class="user-name"><%= @user.name %> <%= @user.lastname %></div>
    </div>
    
    <div class="section">
      <h2 class="section-title">Datos de Cuenta</h2>
      
      <div class="account-details">
        <div class="account-item">
          <div class="info-label">Alias</div>
          <div class="info-value"><%= @alias %></div>
        </div>
        <div class="account-item">
          <div class="info-label">CVU</div>
          <div class="info-value"><%= @cvu %></div>
        </div>
      </div>
      
      <a href="/change_alias" class="btn-change">Cambiar Alias</a>
    </div>
    
    <div class="section">
      <h2 class="section-title">Tarjeta de Débito Virtual</h2>
      
      <% if @virtual_card %>
        <div class="virtual-card">
          <div class="card-header">
            <div class="card-id">ID: <%= @virtual_card.frontal_id %></div>
            <div class="card-logo">JubiCard</div>
          </div>
          
          <div class="card-number"><%= @virtual_card.card_number.scan(/.{4}/).join(' ') %></div>
          
          <div class="card-details">
            <div class="card-holder">
              <div class="card-label">TITULAR</div>
              <div class="card-value"><%= @user.name %> <%= @user.lastname %></div>
            </div>
            <div class="card-expiry">
              <div class="card-label">VENCE</div>
              <div class="card-value"><%= @virtual_card.expiration_date.strftime('%m/%y') %></div>
            </div>
          </div>
          
          <div class="card-footer">
            <div class="card-cvv">CVV: <%= @virtual_card.cvv %></div>
          </div>
        </div>
      <% else %>
        <div class="no-card">
          <p>No tienes una tarjeta virtual generada</p>
          <form action="/generate_virtual_card" method="post">
            <button type="submit" class="btn-generate">Generar Tarjeta</button>
          </form>
        </div>
      <% end %>
    </div>
  </div>
</body>
</html>