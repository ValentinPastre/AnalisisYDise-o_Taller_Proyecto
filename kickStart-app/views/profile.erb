<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Información de Usuario</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 30px;
      background-color: #f4f4f4;
    }

    .panel {
      max-width: 500px;
      margin: 0 auto;
      background-color: white;
      padding: 30px 50px;
      border-radius: 12px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    }

    .info-item {
      margin-bottom: 15px;
      font-size: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .section-title {
      font-size: 18px;
      margin-top: 30px;
      margin-bottom: 10px;
      text-align: center;
      font-weight: bold;
      color: #333;
    }

    .no-data {
      text-align: center;
      color: #777;
      font-style: italic;
    }

    .btn-delete, .btn-add, .btn-erase {
      border: none;
      border-radius: 6px;
      padding: 6px 12px;
      font-size: 16px;
      color: white;
      cursor: pointer;
    }

    .btn-erase {
      background-color:rgb(114, 114, 114);
    }
    .btn-delete{
      background-color: #e74c3c;
    }
    .btn-add {
      background-color: #27ae60;
    }
  </style>
</head>
<body>
  <div class="panel">
    <h2 style="text-align: center; margin-bottom: 30px;">Perfil de Usuario</h2>

    <div class="info-item"><strong>Nombre:</strong> <%= @user.name %></div>
    <div class="info-item"><strong>Apellido:</strong> <%= @user.lastname %></div>
    <div class="info-item"><strong>DNI:</strong> <%= @user.dni %></div>
    <div class="info-item"><strong>CUIL:</strong> <%= @user.cuil %></div>
    <div class="info-item"><strong>Email:</strong> <%= @account.email %></div>
    <% if @secq.any? %>
      <% @secq.each do |secquest| %>
        <div class="info-item">
          <span><strong>Pregunta de Seguridad: </strong><%= secquest.question %></span>
          <form action="/security-question-eliminar" method="post" style="margin: 0;">
            <input type="hidden" name="sq_id" value="<%= secquest.id %>">
            <button type="submit" class="btn-delete">Eliminar</button>
          </form>
        </div>
      <% end %>
    <% else %>
      <div class="info-item">
        <span>
          <strong>Pregunta de seguridad: </strong>
          <span style="color: #777; font-style: italic;">No hay preguntas aún</span>
        </span>
        <form action="/security-question-agregar" method="get" style="margin-left: 10px;">
          <button type="submit" class="btn-add">Agregar</button>
        </form>
      </div>
    <% end %>

    <div style="border-top: 2px solid #ccc; margin: 30px 0;"></div>
    <div class="section-title">Confidentes</div>
      <div style="background-color: #e0e0e0; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; text-align: center; font-size: 15px; color: #333;">
        Acá podés administrar las personas de confianza vinculadas a tu cuenta.
      </div>
      <div style="background-color: #e0e0e0; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; text-align: center; font-size: 15px; color: #333;">
        Estas personas recibirán un correo electrónico por cada transferencia o pagos que realices.
      </div>

    <% if @confident.any? %>
      <% @confident.each do |conf| %>
        <div class="info-item">
          <span><%= conf.email %></span>
          <form action="/confidente_eliminar" method="post" style="margin: 0;">
            <input type="hidden" name="confident_id" value="<%= conf.id %>">
            <button type="submit" class="btn-delete" style="font-size: 16px">Eliminar confidente</button>
          </form>
        </div>
      <% end %>
      <div style="text-align: center; margin-top: 20px;">
        <form action="/confidente_agregar" method="get" style="display: inline-block;">
          <button type="submit" class="btn-add" style="font-size: 16px">Agregar confidente</button>
        </form>
      </div>
    <% else %>
      <div class="info-item no-data">
        No hay confidentes aún
        <form action="/confidente_agregar" method="get" style="margin-left: 10px;">
          <button type="submit" class="btn-add" style="font-size: 15px">Agregar confidente</button>
        </form>
      </div>
    <% end %>
  </div>
  <div style="text-align: center; margin-top: 20px;">
    <form action="/profile/predelete" method="get" style="display: inline-block;">
      <button type="submit" class="btn-erase" style="font-size: 21px">Eliminar Cuenta</button>
    </form>
  </div>
</body>
</html>

