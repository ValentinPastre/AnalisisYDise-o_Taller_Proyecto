<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Pagar Transporte - JubiPago</title>
  <style>
    body {
      font-family: sans-serif;
      background-color: #f6f6f6;
      margin: 30px;
      padding: 0;
    }

    .container {
      width: 90%;
      max-width: 600px;
      margin: 40px auto;
      background-color: white;
      border-radius: 10px;
      box-shadow: 0 0 12px rgba(0,0,0,0.1);
      padding: 30px;
    }

    h2 {
      margin-top: 0;
      text-align: center;
      color: #333;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 20px;
      margin-top: 20px;
    }

    label {
      font-weight: bold;
    }

    select, input[type="text"] {
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 6px;
      font-size: 16px;
    }

    .botones {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 20px;
    flex-wrap: wrap;
  }

  .botones input,
  .botones a {
    padding: 10px 25px;
    font-size: 16px;
    background-color: #bbb;
    color: black;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    transition: background-color 0.2s ease;
    min-width: 120px;
    text-align: center;
  }

  .botones input:hover,
  .botones a:hover {
    background-color: #999;
  }

  .error-message {
    background-color: #ffe0e0;
    border: 1px solid #ff5c5c;
    color: #b30000;
    padding: 12px 16px;
    border-radius: 8px;
    margin-bottom: 20px;
    font-weight: bold;
    text-align: center;
  }

  .form-field {
  display: flex;
  flex-direction: column;
  margin-bottom: 16px;
}

.form-field label {
  font-weight: bold;
  margin-bottom: 6px;
}

.form-field input,
.form-field select {
  padding: 10px;
  border: 1px solid #ccc;
  border-radius: 6px;
  font-size: 16px;
}

label {
  white-space: nowrap;
}


</style>
</head>
<body>
  <div class="container">
    <h2>Pagar Transporte</h2>
    <% if @error %>
        <div class="error-message">
          <span> <%= @error %></span>
        </div>
      <% end %>

    <form action="/transport" method="post">
     <div class="form-field">
        <label for="empresa">Empresa de Transporte:</label>
        <select name="empresa_id" id="empresa" required>
          <% @empresas.each do |empresa| %>
            <option value="<%= empresa.id %>"><%= empresa.name %></option>
          <% end %>
        </select>
      </div>

      <div class="form-field">
        <label for="tarjeta">Número de Tarjeta de Transporte:</label>
        <input type="text" name="numero_tarjeta" id="tarjeta" required>
      </div>

      <div class="botones">
        <input type="submit" value="Continuar">
      </div>
    </form>
  </div>
</body>
</html>
