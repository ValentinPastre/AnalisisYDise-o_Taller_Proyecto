<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Pregunta de Seguridad</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 30px;
      background-color: #f4f4f4;
    }

    .panel {
      max-width: 500px;
      margin: 0 auto;
      background-color: white;
      padding: 30px 50px;
      border-radius: 12px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 20px;
    }

    label {
      font-weight: bold;
      font-size: 16px;
    }

    input[type="text"] {
      padding: 10px;
      border-radius: 6px;
      border: 1px solid #ccc;
      font-size: 16px;
    }

    .btn-delete, .btn-add, .btn-erase {
      border: none;
      border-radius: 6px;
      padding: 6px 12px;
      font-size: 16px;
      color: white;
      cursor: pointer;
    }

    .btn-erase {
      background-color:rgb(114, 114, 114);
    }
    .btn-delete{
      background-color: #e74c3c;
    }
    .btn-add {
      background-color: #27ae60;
    }
    .info-item {
      margin-bottom: 15px;
      font-size: 16px;
      display: flex;
      justify-content: center;
      align-items: center;
    }
  </style>
</head>
<body>
  <div class="panel">
    <h2 style="text-align: center; margin-bottom: 30px;">
      ¿Está seguro que desea eliminar su cuenta?
    </h2>
  
    <!-- Contenedor flex para los dos formularios -->
    <div style="display: flex; justify-content: center; gap: 20px;">
      <form action="/welcome" method="post">
        <button type="submit" class="btn-delete">Cancelar</button>
      </form>
  
      <form action="/profile/delete" method="post">
        <button type="submit" class="btn-add">Sí, estoy seguro/a</button>
      </form>
    </div>
  </div>
</body>
</html>