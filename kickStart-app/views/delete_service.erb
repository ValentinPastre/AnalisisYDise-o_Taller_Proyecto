<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Eliminar Servicio - JubiPago</title>
  <style>
    body {
      font-family: sans-serif;
      background-color: #f6f6f6;
      margin: 30px;
      padding: 0;
    }

    .container {
      width: 90%;
      max-width: 600px;
      margin: 40px auto;
      background-color: white;
      border-radius: 10px;
      box-shadow: 0 0 12px rgba(0,0,0,0.1);
      padding: 30px;
    }

    h2 {
      margin-top: 0;
      text-align: center;
      color: #333;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
      table-layout: fixed;
    }

    th, td {
      text-align: center;
      padding: 12px;
      border-bottom: 1px solid #ccc;
    }

    th {
      background-color: #f0f0f0;
    }

    .service-row:hover {
      background-color: #f9f9f9;
      cursor: pointer;
    }

    .selected {
      background-color: #e6f7ff;
    }

    .button {
      display: flex;
      justify-content: space-around;
      margin-top: 20px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .button button, .button a {
      flex: 1 1 40%;
      text-align: center;
      padding: 10px 18px;
      border-radius: 5px;
      background-color: #ccc;
      text-decoration: none;
      color: black;
      min-width: 120px;
      border: none;
      cursor: pointer;
    }

    .button button:hover, .button a:hover {
      background-color: #bbb;
    }

    .button button[type="submit"] {
      background-color: #ff6b6b;
      color: white;
    }

    .button button[type="submit"]:hover {
      background-color: #ff5252;
    }

    #delete-form {
      display: none;
    }
  </style>
</head>
<body>
  <div class="container">
    <h2>Eliminar servicio</h2>
    <p>Seleccione el servicio que desea eliminar:</p>

    <table>
      <thead>
        <tr>
          <th>Servicio</th>
          <th>Tipo de pago</th>
          <th>Monto</th>
          <th>Estado</th>
        </tr>
      </thead>
      <tbody>
        <% if @services.any? %>
          <% @services.each do |service| %>
            <% factura = AmountToPay.where(service_id: service.id).order(created_at: :desc).first %>
            <tr class="service-row" data-id="<%= service.id %>">
              <td><%= service.service_name %></td>
              <td><%= service.tipo_pago %></td>
              <td>
                <% if factura %>
                  $<%= factura.amount_cents / 100.0 %>
                <% else %>
                  -
                <% end %>
              </td>
              <td>
                <% if factura %>
                  <%= factura.paid ? "Pagado" : "Impago" %>
                <% else %>
                  Sin factura
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="4">No hay servicios registrados.</td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <form id="delete-form" action="/services/delete" method="post">
      <input type="hidden" name="service_id" id="service-id-input">
      <div class="button">
        <button type="submit">Confirmar Eliminación</button>
        <a href="/services">Cancelar</a>
      </div>
    </form>
  </div>

  <script>
    const rows = document.querySelectorAll('.service-row');
    const form = document.getElementById('delete-form');
    const input = document.getElementById('service-id-input');
    let selectedRow = null;

    rows.forEach(row => {
      row.addEventListener('click', () => {
        if (selectedRow) {
          selectedRow.classList.remove('selected');
        }
        
        row.classList.add('selected');
        selectedRow = row;
        
        const serviceId = row.dataset.id;
        input.value = serviceId;
        form.style.display = 'block';
      });
    });
  </script>
</body>
</html>