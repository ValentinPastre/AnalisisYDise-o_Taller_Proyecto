<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Servicios - JubiPago</title>
  <style>
    body {
      font-family: sans-serif;
      background-color: #f6f6f6;
      margin: 30px;
      padding: 0;
    }

    .container {
      width: 90%;
      max-width: 600px; /* más ancho que antes */
      margin: 40px auto;
      background-color: white;
      border-radius: 10px;
      box-shadow: 0 0 12px rgba(0,0,0,0.1);
      padding: 30px;
    }

    h2 {
      margin-top: 0;
      text-align: center;
      color: #333;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
      table-layout: fixed;
    }

    th, td {
      text-align: center;
      padding: 12px;
      border-bottom: 1px solid #ccc;
    }

    th {
      background-color: #f0f0f0;
    }

    th:nth-child(1), td:nth-child(1) {
      width: 25%;
    }

    th:nth-child(2), td:nth-child(2) {
      width: 25%;
    }

    th:nth-child(3), td:nth-child(3) {
      width: 25%;
    }

    th:nth-child(4), td:nth-child(4) {
      width: 25%;
    }

    .button {
      display: flex;
      justify-content: space-around; /* distribución equitativa */
      margin-top: 20px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .button a {
      flex: 1 1 40%;
      text-align: center;
      padding: 10px 18px;
      border-radius: 5px;
      background-color: #ccc;
      text-decoration: none;
      color: black;
      min-width: 120px;
    }

    .button a:hover {
      background-color: #bbb;
    }
  </style>
</head>
<body>
  <div class="container">
    <h2>Pago de servicios</h2>

    <table>
      <thead>
        <tr>
          <th>Servicio</th>
          <th>Tipo de pago</th>
          <th>Monto</th>
          <th>Estado</th>
        </tr>
      </thead>
      <tbody>
        <% if @services.any? %>
          <% @services.each do |service| %>
            <% factura = service.amount_to_pay %>
            <tr>
              <td><%= service.service_name %></td>
              <td><%= service.tipo_pago %></td>
              <td>
                <% if factura %>
                  $<%= factura.amount_cents / 100.0 %>
                <% else %>
                  -
                <% end %>
              </td>
              <td>
                <% if factura %>
                  <%= factura.paid ? "Pagado" : "Impago" %>
                <% else %>
                  Sin factura
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="4">No hay servicios registrados.</td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <div class="button">
      <a href="/services/new">Agregar</a>
      <a href="/services/delete">Eliminar</a>
    </div>

    <div class="button">
      <a href="/services/pay">Pagar Servicios</a>
      <a href="/transport">Pagar Transporte</a>
    </div>
  </div>
</body>
</html>
